{
  "cloud": "GoCloud",
  "composeProject": "arrowhead-v52-test-cloud-go",
  "executorType": "arrowhead-cloud-executor",
  "core": ["serviceregistry", "authentication", "consumerauthorization", "serviceorchestration-dynamic", "serviceorchestration-simple"],
  "smoke": ["smoke-test.sh"],
  "systems": [
    {"id": "mqtt-broker", "name": "MQTT broker", "kind": "infrastructure", "services": ["mqtt-broker"]},
    {"id": "amqp-broker", "name": "AMQP broker", "kind": "infrastructure", "services": ["amqp-broker"]},
    {"id": "blacklist", "name": "Blacklist", "kind": "support", "services": ["blacklist"], "alternates": ["blacklist-java"],
     "policies": ["configure-blacklist-policy.sh"]},
    {"id": "translation-manager", "name": "TranslationManager", "kind": "support", "services": ["translation-manager"],
     "policies": ["configure-translation-policy.sh"]},
    {"id": "device-qos-evaluator", "name": "DeviceQoSEvaluator", "kind": "support", "services": ["device-qos-evaluator"]},
    {"id": "onboarding", "name": "Onboarding", "kind": "support", "services": ["onboarding"],
     "policies": ["configure-onboarding-policy.sh"]},
    {"id": "datamanager", "name": "DataManager", "kind": "support", "services": ["datamanager"], "alternates": ["datamanager-rust"],
     "policies": ["configure-datamanager-monitoring-policy.sh"]},
    {"id": "timemanager", "name": "TimeManager", "kind": "support", "services": ["timemanager"], "alternates": ["timemanager-rust"],
     "provision": ["provision-timemanager-identity.sh"], "policies": ["configure-timemanager-policy.sh"]},
    {"id": "eventhandler", "name": "EventHandler", "kind": "support", "services": ["eventhandler"],
     "policies": ["configure-eventhandler-policy.sh"]},
    {"id": "plantdescriptionengine", "name": "PlantDescriptionEngine", "kind": "support", "services": ["plantdescriptionengine"],
     "provision": ["provision-plantdescriptionengine-identity.sh"],
     "policies": ["configure-plantdescriptionengine-policy.sh", "configure-pde-dso-policy.sh"]},
    {"id": "configuration", "name": "Configuration", "kind": "support", "services": ["configuration"],
     "provision": ["provision-configuration-identity.sh"], "policies": ["configure-configuration-policy.sh"]},
    {"id": "choreographer", "name": "Choreographer", "kind": "support", "services": ["choreographer"],
     "provision": ["provision-choreographer-identity.sh"], "policies": ["configure-choreographer-policy.sh"]},
    {"id": "sysmonitor", "name": "SysMonitor", "kind": "support", "services": ["sysmonitor"], "alternates": ["sysmonitor-rust"],
     "requires": ["amqp-broker"],
     "provision": ["provision-sysmonitor-identity.sh"], "policies": ["configure-sysmonitor-policy.sh", "configure-all-sysmonitor-policies.sh"]},
    {"id": "gatekeeper", "name": "Gatekeeper", "kind": "support", "services": ["gatekeeper"],
     "provision": ["provision-gatekeeper-identity.sh"], "policies": ["configure-gatekeeper-policy.sh"]},
    {"id": "gatetunnel", "name": "GateTunnel", "kind": "support", "services": ["gatetunnel"], "requires": ["gatekeeper"],
     "provision": ["provision-gatetunnel-identity.sh"], "policies": ["configure-gatetunnel-policy.sh"]},
    {"id": "aigym", "name": "AIGym", "kind": "support", "services": ["aigym"], "requires": ["datamanager", "sysmonitor", "mqtt-broker"],
     "provision": ["provision-aigym-identity.sh"], "policies": ["configure-aigym-policy.sh"]},
    {"id": "certificate-authority", "name": "CertificateAuthority", "kind": "support", "services": ["certificate-authority"]},
    {"id": "random-data-producer", "name": "RandomDataProducer", "kind": "application", "services": ["random-data-producer"],
     "requires": ["datamanager", "amqp-broker"], "policies": ["configure-random-producer-policy.sh"]},
    {"id": "test-translation", "name": "TestTranslation", "kind": "application", "services": ["test-translation"],
     "requires": ["translation-manager"]},
    {"id": "cloud-monitor", "name": "Cloud monitor (LocalCloudManager)", "kind": "application",
     "services": ["docker-proxy", "cloud-monitor-api", "cloud-monitor-ui"]}
  ]
}
